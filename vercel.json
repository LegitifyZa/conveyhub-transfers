{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build && rm -rf dist/server && npm run build:server && node scripts/fix-server-imports.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/server/**"
    },
    "api/index.ts": {
      "includeFiles": "dist/server/**"
    }
  }
}