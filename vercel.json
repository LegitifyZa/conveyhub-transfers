{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build && npm run build:server && node scripts/fix-server-imports.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server/**"
    }
  }
}