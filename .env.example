# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legitify_convey_hub
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSL=false
DB_SCHEMA=transfers

# Test-only database (used by python_server integration tests)
TEST_DATABASE_URL=

# Database Connection Pool Settings
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# Application Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/api
VITE_API_BASE_URL=/api
VITE_API_PORT=3000

# Loqate Address Verification API
LOQATE_API_KEY=your_loqate_key

# DEEDLY FastAPI service base URL (server-side only). Hosts the routes that
# need the Legitify S2S lane, e.g. POST /api/v1/golden-records/search.
DEEDLY_API_BASE_URL=http://localhost:3100

# Platform service connectivity (placeholder values only)
# SECRET_KEY is the platform X-Service-Key. Server-side only: never expose it via VITE_*/NEXT_PUBLIC_* or logs.
SECRET_KEY=your_secret_key
# Legitify nginx gateway base URL. Local: http://localhost:8000, staging: https://staging-api.legitify.co.za, production: https://api.legitify.co.za
LEGITIFY_API_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
AUDIT_DATABASE_URL=postgresql://your_username:your_password@localhost:5432/legitify_auditor
